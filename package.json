{
  "name": "opencodependent",
  "version": "0.0.0",
  "description": "OpenCode for JetBrains IDEs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc}\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
